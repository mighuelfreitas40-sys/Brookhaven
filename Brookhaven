-- Cabelo RGB
local isHairActive = false
local hairConnection = nil

local function toggleHairRGB(state)
    isHairActive = state
    
    if isHairActive then
        local Player = game.Players.LocalPlayer
        local Character = Player.Character or Player.CharacterAdded:Wait()
        
        local velocidade = 0.5
        local counter = 0

        local function obterHandlesDeCabelo()
            local handles = {}
            for _, objeto in pairs(Character:GetChildren()) do
                if objeto:IsA("Accessory") and objeto.AccessoryType == Enum.AccessoryType.Hair then
                    local handle = objeto:FindFirstChild("Handle")
                    if handle then
                        table.insert(handles, handle)
                    end
                end
            end
            return handles
        end

        local cabelos = obterHandlesDeCabelo()
        
        local function onCharacterAdded(newCharacter)
            Character = newCharacter
            cabelos = obterHandlesDeCabelo()
        end
        
        Player.CharacterAdded:Connect(onCharacterAdded)

        hairConnection = game:GetService("RunService").RenderStepped:Connect(function(dt)
            if not isHairActive then
                hairConnection:Disconnect()
                return
            end
            
            counter = counter + (dt * velocidade)
            if counter > 1 then counter = 0 end
            
            local corArcoIris = Color3.fromHSV(counter, 1, 1)
            
            for _, handle in pairs(cabelos) do
                handle.Color = corArcoIris
                
                if handle:IsA("MeshPart") and handle.TextureID ~= "" then
                    handle.TextureID = "" 
                end
            end
        end)
    else
        if hairConnection then
            hairConnection:Disconnect()
            hairConnection = nil
        end
    end
end

