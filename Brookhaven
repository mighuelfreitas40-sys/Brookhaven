end

local function getRoot()
    local char = getChar()
    return char and char:FindFirstChild("HumanoidRootPart")
end

local function getHum()
    local char = getChar()
    return char and char:FindFirstChildOfClass("Humanoid")
end

local function getTargetChar()
    if not selectedPlayerName then return nil end
    local target = Players:FindFirstChild(selectedPlayerName)
    if not target then return nil end
    local char = target.Character
    if not char then
        for i = 1, 15 do
            task.wait(0.1)
            char = target.Character
            if char then break end
        end
    end
    return char
end

local function KillPlayerCouch()
    if not selectedPlayerName then
        notify("Erro", "Nenhum jogador selecionado")
        return
    end

    local target = Players:FindFirstChild(selectedPlayerName)
    if not target then
        notify("Erro", "Jogador nao encontrado")
        return
    end

    if target == LocalPlayer then
        notify("Erro", "Nao e possivel matar a si mesmo")
        return
    end

    local tChar = getTargetChar()
    if not tChar then
        notify("Erro", "Personagem do alvo nao carregou")
        return
    end

    local tRoot = tChar:FindFirstChild("HumanoidRootPart")
    local tHum = tChar:FindFirstChildOfClass("Humanoid")

    if not tRoot or not tHum then
        notify("Erro", "Alvo invalido")
        return
    end

    if tHum.Health <= 0 then
        notify("Erro", "Alvo ja esta morto")
        return
    end

    local char = getChar()
    local hum = getHum()
    local root = getRoot()

    if not char or not hum or not root then
        notify("Erro", "Seu personagem nao encontrado")
        return
    end

    local originalPos = root.CFrame
    local sitPos = Vector3.new(145.51, -350.09, 21.58)
    local isKilling = true

    pcall(function()
        ReplicatedStorage:WaitForChild("RE"):WaitForChild("1Clea1rTool1s"):FireServer("ClearAllTools")
    end)
    task.wait(0.2)

    local success = pcall(function()
        return ReplicatedStorage.RE:FindFirstChild("1Too1l"):InvokeServer("PickingTools", "Couch")
    end)

    if not success then
        isKilling = false
        notify("Erro", "Falha ao pegar ferramenta")
        return
    end

    task.wait(0.3)

    local tool = LocalPlayer.Backpack:FindFirstChild("Couch")
    if not tool then
        isKilling = false
        notify("Erro", "Ferramenta Couch nao encontrada")
        return
    end

    tool.Parent = char
    task.wait(0.1)

    pcall(function()
        VirtualInputManager:SendKeyEvent(true, Enum.KeyCode.F, false, game)
    end)
    task.wait(0.1)

    pcall(function()
        hum:SetStateEnabled(Enum.HumanoidStateType.Seated, false)
        hum.PlatformStand = false
    end)

    cam.CameraSubject = tRoot

    local seat = char:FindFirstChild("Couch") and char.Couch:FindFirstChild("Seat")
    if not seat then
        local couchTool = char:FindFirstChild("Couch")
        if couchTool then
            for _, v in pairs(couchTool:GetDescendants()) do
                if v:IsA("Seat") or v:IsA("VehicleSeat") then
                    seat = v
                    break
                end
            end
        end
    end

    if not seat then
        isKilling = false
        notify("Erro", "Seat do Couch nao encontrado")
        return
    end

    local align = Instance.new("BodyPosition")
    align.Name = "KillAlign"
    align.MaxForce = Vector3.new(math.huge, math.huge, math.huge)
    align.D = 10
    align.P = 30000
    align.Position = tRoot.Position
    align.Parent = root

    local bodyGyro = Instance.new("BodyGyro")
    bodyGyro.MaxTorque = Vector3.new(math.huge, math.huge, math.huge)
    bodyGyro.P = 30000
    bodyGyro.Parent = root

    task.spawn(function()
        local startTime = tick()
        local killed = false
        local angle = 0
        local orbitRadius = 0.5
        local orbitSpeed = 25

        while tick() - startTime < 8 do
            if not target or not target.Character then break end
            local currentHum = target.Character:FindFirstChildOfClass("Humanoid")
            if not currentHum then break end

            if currentHum.Sit then
                killed = true
                break
            end

            local hrp = target.Character:FindFirstChild("HumanoidRootPart")
            if not hrp then break end

            angle = angle + orbitSpeed * task.wait()
            local orbitOffset = Vector3.new(
                math.cos(angle) * orbitRadius,
                0,
                math.sin(angle) * orbitRadius
            )

            local targetPos = hrp.Position + orbitOffset

            pcall(function()
                root.CFrame = CFrame.new(targetPos)
                align.Position = targetPos
                if seat then
                    seat.CFrame = CFrame.new(hrp.Position)
                end
            end)
        end

        if align then align:Destroy() end
        if bodyGyro then bodyGyro:Destroy() end

        pcall(function()
            hum:SetStateEnabled(Enum.HumanoidStateType.Seated, true)
            hum.PlatformStand = false
        end)

        cam.CameraSubject = hum

        for _, p in pairs(char:GetDescendants()) do
            if p:IsA("BasePart") then
                p.Velocity = Vector3.zero
                p.RotVelocity = Vector3.zero
            end
        end

        task.wait(0.1)

        if killed then
            root.CFrame = CFrame.new(sitPos)
            task.wait(0.5)
        end

        task.wait(0.3)

        local couchTool = char:FindFirstChild("Couch")
        if couchTool then
            couchTool.Parent = LocalPlayer.Backpack
        end

        task.wait(0.01)

        pcall(function()
            ReplicatedStorage.RE:FindFirstChild("1Too1l"):InvokeServer("PickingTools", "Couch")
        end)

        task.wait(0.2)

        if not killed then
            root.CFrame = originalPos
        else
            task.wait(0.5)
            root.CFrame = originalPos
            root.Velocity = Vector3.zero
            root.RotVelocity = Vector3.zero
        end

        isKilling = false

        notify(killed and "Sucesso!" or "Falha",
            killed and "Player morto com sucesso!" or "Nao foi possivel matar o player")
    end)
end

local function KillPlayerBus()
    local target = Players:FindFirstChild(selectedPlayerName)
    if not target or not target.Character then
        notify("Erro", "Alvo nao encontrado")
        return
    end

    local character = getChar()
    local humanoidRootPart = getRoot()
    if not humanoidRootPart then
        notify("Erro", "Seu personagem nao encontrado")
        return
    end

    local originalPosition = humanoidRootPart.CFrame
    local isActive = true

    local function GetBus()
        local vehicles = workspace:FindFirstChild("Vehicles")
        if vehicles then
            return vehicles:FindFirstChild(LocalPlayer.Name .. "Car")
        end
        return nil
    end

    local bus = GetBus()

    if not bus then
        humanoidRootPart.CFrame = CFrame.new(1118.81, 75.998, -1138.61)
        task.wait(0.5)
        local remoteEvent = ReplicatedStorage:FindFirstChild("RE")
        if remoteEvent and remoteEvent:FindFirstChild("1Ca1r") then
            remoteEvent["1Ca1r"]:FireServer("PickingCar", "SchoolBus")
        end
        task.wait(1)
        bus = GetBus()
    end

    if not bus then
        isActive = false
        notify("Erro", "Nao conseguiu spawnar o onibus")
        return
    end

    local busBody = bus:FindFirstChild("Body")
    local seat = busBody and busBody:FindFirstChild("VehicleSeat")

    if seat and character:FindFirstChildOfClass("Humanoid") then
        local hum = character:FindFirstChildOfClass("Humanoid")
        local attempts = 0
        repeat
            humanoidRootPart.CFrame = seat.CFrame * CFrame.new(0, 3, 0)
            task.wait(0.05)
            if not hum.Sit then
                pcall(function()
                    seat:Sit(hum)
                end)
            end
            attempts = attempts + 1
        until hum.Sit or not bus.Parent or attempts > 50

        if not hum.Sit then
            isActive = false
            notify("Erro", "Nao conseguiu entrar no onibus")
            return
        end

        for _, v in pairs(busBody:GetChildren()) do
            if v:IsA("Seat") or v:IsA("VehicleSeat") then
                if v ~= seat then
                    v.CanTouch = false
                    v.CanCollide = false
                end
            end
        end
    end

    local targetSeat = nil
    for _, v in pairs(bus:GetDescendants()) do
        if v:IsA("Seat") or v:IsA("VehicleSeat") then
            if v ~= seat then
                targetSeat = v
                break
            end
        end
    end

    local function TrackPlayer()
        local startTime = tick()
        local lastTargetPos = nil
        local stuckCounter = 0
        local verticalAngle = 0
        local verticalSpeed = 8
        local verticalRange = 2.5

        while isActive do
            if selectedPlayerName then
                local targetPlayer = Players:FindFirstChild(selectedPlayerName)
                if targetPlayer and targetPlayer.Character and targetPlayer.Character:FindFirstChild("HumanoidRootPart") then
                    local targetHumanoid = targetPlayer.Character:FindFirstChildOfClass("Humanoid")
                    local targetRoot = targetPlayer.Character.HumanoidRootPart

                    if targetHumanoid and not targetHumanoid.Sit then
                        pcall(function()
                            if targetSeat then
                                verticalAngle = verticalAngle + verticalSpeed * task.wait()
                                local yOffset = math.sin(verticalAngle) * verticalRange
                                targetSeat.CFrame = CFrame.new(targetRoot.Position + Vector3.new(0, yOffset, 0))
                                targetSeat:Sit(targetHumanoid)
                            end
                        end)
                    end

                    if targetHumanoid and targetHumanoid.Sit then
                        if bus and bus.PrimaryPart then
                            bus:SetPrimaryPartCFrame(CFrame.new(Vector3.new(9999, -450, 9999)))
                        elseif busBody then
                            local pp = busBody:FindFirstChildWhichIsA("BasePart")
                            if pp then pp.CFrame = CFrame.new(9999, -450, 9999) end
                        end

                        notify("Sucesso", "Jogador morto!")
                        task.wait(0.2)

                        local hum = character:FindFirstChildWhichIsA("Humanoid")
                        if hum then
                            hum:ChangeState(Enum.HumanoidStateType.Jumping)
                        end

                        task.wait(0.5)
                        humanoidRootPart.CFrame = originalPosition
                        isActive = false
                        break
                    end

                    local currentPos = targetRoot.Position
                    if lastTargetPos and (currentPos - lastTargetPos).Magnitude < 0.5 then
                        stuckCounter = stuckCounter + 1
                    else
                        stuckCounter = 0
                    end
                    lastTargetPos = currentPos

                    pcall(function()
                        if bus and bus.PrimaryPart then
                            bus:SetPrimaryPartCFrame(CFrame.new(targetRoot.Position))
                        elseif busBody then
                            local pp = busBody:FindFirstChildWhichIsA("BasePart")
                            if pp then
                                bus:SetPrimaryPartCFrame(CFrame.new(targetRoot.Position))
                            end
                        end
                        if targetSeat then
                            verticalAngle = verticalAngle + verticalSpeed * task.wait()
                            local yOffset = math.sin(verticalAngle) * verticalRange
                            targetSeat.CFrame = CFrame.new(targetRoot.Position + Vector3.new(0, yOffset, 0))
                        end
                    end)

                    if tick() - startTime > 20 then
                        notify("Falha", "Tempo esgotado - nao conseguiu matar")
                        isActive = false
                        break
                    end
                else
                    notify("Erro", "Alvo desapareceu")
                    isActive = false
                    break
                end
            end
            RunService.RenderStepped:Wait()
        end

        if isActive == false then
            local hum = character:FindFirstChildWhichIsA("Humanoid")
            if hum then
                hum:ChangeState(Enum.HumanoidStateType.Jumping)
            end
            task.wait(0.3)
            humanoidRootPart.CFrame = originalPosition
        end
    end

    spawn(TrackPlayer)
end

local function BringPlayer()
    if not selectedPlayerName then
        notify("Erro", "Nenhum jogador selecionado")
        return
    end

    local target = Players:FindFirstChild(selectedPlayerName)
    if not target then
        notify("Erro", "Jogador nao encontrado")
        return
    end

    local tChar = getTargetChar()
    if not tChar then
        notify("Erro", "Personagem do alvo nao carregou")
        return
    end

    local tRoot = tChar:FindFirstChild("HumanoidRootPart")
    local tHum = tChar:FindFirstChildOfClass("Humanoid")

    if not tRoot or not tHum then
        notify("Erro", "Alvo invalido")
        return
    end

    local char = getChar()
    local hum = getHum()
    local root = getRoot()

    if not char or not hum or not root then
        notify("Erro", "Personagem nao encontrado")
        return
    end

    local originalPos = root.Position

    pcall(function()
        ReplicatedStorage:WaitForChild("RE"):WaitForChild("1Clea1rTool1s"):FireServer("ClearAllTools")
    end)
    task.wait(0.2)

    local success = pcall(function()
        return ReplicatedStorage.RE:FindFirstChild("1Too1l"):InvokeServer("PickingTools", "Couch")
    end)

    if not success then
        notify("Erro", "Falha ao pegar ferramenta")
        return
    end

    task.wait(0.3)

    local tool = LocalPlayer.Backpack:FindFirstChild("Couch")
    if not tool then
        notify("Erro", "Ferramenta nao encontrada")
        return
    end

    tool.Parent = char
    task.wait(0.1)

    VirtualInputManager:SendKeyEvent(true, Enum.KeyCode.F, false, game)
    task.wait(0.1)

    hum:SetStateEnabled(Enum.HumanoidStateType.Seated, false)
    hum.PlatformStand = false
    cam.CameraSubject = tChar:FindFirstChild("Head") or tRoot or hum

    local align = Instance.new("BodyPosition")
    align.Name = "BringAlign"
    align.MaxForce = Vector3.new(math.huge, math.huge, math.huge)
    align.D = 10
    align.P = 30000
    align.Position = root.Position
    align.Parent = tRoot

    task.spawn(function()
        local angle = 0
        local startTime = tick()
        local success = false

        while tick() - startTime < 6 do
            if not target or not target.Character then break end
            local currentHum = target.Character:FindFirstChildOfClass("Humanoid")
            if not currentHum then break end

            if currentHum.Sit then
                success = true
                break
            end

            local hrp = target.Character:FindFirstChild("HumanoidRootPart")
            if not hrp then break end

            local adjustedPos = hrp.Position + (hrp.Velocity / 1.5)
            angle = angle + 50
            root.CFrame = CFrame.new(adjustedPos + Vector3.new(0, 2, 0)) * CFrame.Angles(math.rad(angle), 0, 0)
            align.Position = root.Position + Vector3.new(2, 0, 0)

            task.wait()
        end

        align:Destroy()
        hum:SetStateEnabled(Enum.HumanoidStateType.Seated, true)
        hum.PlatformStand = false
        cam.CameraSubject = hum

        for _, p in pairs(char:GetDescendants()) do
            if p:IsA("BasePart") then
                p.Velocity = Vector3.zero
                p.RotVelocity = Vector3.zero
            end
        end

        task.wait(0.1)

        if success then
            root.Anchored = true
            root.CFrame = CFrame.new(originalPos)
            task.wait(0.001)
            root.Anchored = false
        end

        task.wait(0.7)

        local couchTool = char:FindFirstChild("Couch")
        if couchTool then
            couchTool.Parent = LocalPlayer.Backpack
        end

        task.wait(0.001)
        pcall(function()
            ReplicatedStorage.RE:FindFirstChild("1Too1l"):InvokeServer("PickingTools", "Couch")
        end)

        notify(success and "Sucesso!" or "Falha",
            success and "Player puxado com sucesso!" or "Nao foi possivel puxar o player")
    end)
end
