-- Função melhorada para Kill Player com Couch (MÁXIMO DE VERIFICAÇÕES)
local function KillPlayerCouch()
    -- VERIFICAÇÃO 1: Player selecionado
    if not selectedPlayerName then
        OrionLib:MakeNotification({
            Name = "Erro",
            Content = "Nenhum jogador selecionado",
            Image = "rbxassetid://4483345998",
            Time = 3
        })
        return
    end
    
    -- VERIFICAÇÃO 2: Player existe
    local target = Players:FindFirstChild(selectedPlayerName)
    if not target then
        OrionLib:MakeNotification({
            Name = "Erro",
            Content = "Jogador não encontrado",
            Image = "rbxassetid://4483345998",
            Time = 3
        })
        return
    end
    
    -- VERIFICAÇÃO 3: Não pode matar a si mesmo
    if target == LocalPlayer then
        OrionLib:MakeNotification({
            Name = "Erro",
            Content = "Não é possível matar a si mesmo",
            Image = "rbxassetid://4483345998",
            Time = 3
        })
        return
    end
    
    -- VERIFICAÇÃO 4: Personagem do alvo existe
    local maxAttempts = 15
    local attempts = 0
    local targetChar = target.Character
    
    while not targetChar and attempts < maxAttempts do
        task.wait(0.1)
        targetChar = target.Character
        attempts = attempts + 1
    end
    
    if not targetChar then
        OrionLib:MakeNotification({
            Name = "Erro",
            Content = "Personagem do alvo não carregou",
            Image = "rbxassetid://4483345998",
            Time = 3
        })
        return
    end
    
    -- VERIFICAÇÃO 5: Componentes do alvo existem
    local tRoot = targetChar:FindFirstChild("HumanoidRootPart")
    local tHum = targetChar:FindFirstChildOfClass("Humanoid")
    
    if not tRoot then
        OrionLib:MakeNotification({
            Name = "Erro",
            Content = "Alvo sem HumanoidRootPart",
            Image = "rbxassetid://4483345998",
            Time = 3
        })
        return
    end
    
    if not tHum then
        OrionLib:MakeNotification({
            Name = "Erro",
            Content = "Alvo sem Humanoid",
            Image = "rbxassetid://4483345998",
            Time = 3
        })
        return
    end
    
    -- VERIFICAÇÃO 6: Alvo não está morto
    if tHum.Health <= 0 then
        OrionLib:MakeNotification({
            Name = "Erro",
            Content = "Alvo já está morto",
            Image = "rbxassetid://4483345998",
            Time = 3
        })
        return
    end

    -- VERIFICAÇÃO 7: Personagem do jogador existe
    local char = LocalPlayer.Character
    if not char then
        OrionLib:MakeNotification({
            Name = "Erro",
            Content = "Seu personagem não encontrado",
            Image = "rbxassetid://4483345998",
            Time = 3
        })
        return
    end
    
    -- VERIFICAÇÃO 8: Componentes do jogador existem
    local hum = char:FindFirstChildOfClass("Humanoid")
    local root = char:FindFirstChild("HumanoidRootPart")
    
    if not hum then
        OrionLib:MakeNotification({
            Name = "Erro",
            Content = "Seu Humanoid não encontrado",
            Image = "rbxassetid://4483345998",
            Time = 3
        })
        return
    end
    
    if not root then
        OrionLib:MakeNotification({
            Name = "Erro",
            Content = "Seu HumanoidRootPart não encontrado",
            Image = "rbxassetid://4483345998",
            Time = 3
        })
        return
    end
    
    -- VERIFICAÇÃO 9: Distância do alvo (não muito longe)
    local distance = (root.Position - tRoot.Position).Magnitude
    if distance > 500 then
        OrionLib:MakeNotification({
            Name = "Aviso",
            Content = "Alvo muito distante (" .. math.floor(distance) .. " studs). Pode falhar.",
            Image = "rbxassetid://4483345998",
            Time = 3
        })
    end

    -- Salvar posição original
    local originalPos = root.Position 
    local sitPos = Vector3.new(145.51, -350.09, 21.58)

    -- VERIFICAÇÃO 10: Limpar ferramentas com pcall
    local success, result = pcall(function()
        ReplicatedStorage:WaitForChild("RE"):WaitForChild("1Clea1rTool1s"):FireServer("ClearAllTools")
    end)
    
    if not success then
        OrionLib:MakeNotification({
            Name = "Erro",
            Content = "Falha ao limpar ferramentas",
            Image = "rbxassetid://4483345998",
            Time = 3
        })
        return
    end
    task.wait(0.2)

    -- VERIFICAÇÃO 11: Pegar sofá com pcall
    success, result = pcall(function()
        return ReplicatedStorage.RE:FindFirstChild("1Too1l"):InvokeServer("PickingTools", "Couch")
    end)
    
    if not success then
        OrionLib:MakeNotification({
            Name = "Erro",
            Content = "Falha ao pegar ferramenta",
            Image = "rbxassetid://4483345998",
            Time = 3
        })
        return
    end
    
    task.wait(0.3)

    -- VERIFICAÇÃO 12: Ferramenta existe no inventário
    local tool = LocalPlayer.Backpack:FindFirstChild("Couch")
    if tool then 
        tool.Parent = char 
    else
        OrionLib:MakeNotification({
            Name = "Erro",
            Content = "Ferramenta Couch não encontrada",
            Image = "rbxassetid://4483345998",
            Time = 3
        })
        return
    end
    task.wait(0.1)

    -- VERIFICAÇÃO 13: Enviar tecla F com pcall
    pcall(function()
        VirtualInputManager:SendKeyEvent(true, Enum.KeyCode.F, false, game)
    end)
    task.wait(0.1)

    -- VERIFICAÇÃO 14: Configurar estados
    pcall(function()
        hum:SetStateEnabled(Enum.HumanoidStateType.Seated, false)
        hum.PlatformStand = false
    end)
    
    -- VERIFICAÇÃO 15: Alvo ainda existe
    if target.Character and target.Character:FindFirstChild("Head") then
        cam.CameraSubject = target.Character.Head
    else
        cam.CameraSubject = tRoot or hum
    end

    -- VERIFICAÇÃO 16: Criar BodyPosition com verificação
    local align = Instance.new("BodyPosition")
    align.Name = "BringPosition"
    align.MaxForce = Vector3.new(math.huge, math.huge, math.huge)
    align.D = 10
    align.P = 30000
    align.Position = root.Position
    align.Parent = tRoot

    task.spawn(function()
        local angle = 0
        local startTime = tick()
        local success = false
        
        while tick() - startTime < 8 do
            -- VERIFICAÇÕES CONTÍNUAS
            if not target then break end
            if not target.Character then break end
            
            local tHum = target.Character:FindFirstChildOfClass("Humanoid")
            if not tHum then break end
            
            -- Sucesso: alvo sentou
            if tHum.Sit then
                success = true
                break
            end

            local hrp = target.Character:FindFirstChild("HumanoidRootPart")
            if not hrp then break end
            
            local adjustedPos = hrp.Position + (hrp.Velocity / 1.5)

            angle = angle + 50
            pcall(function()
                root.CFrame = CFrame.new(adjustedPos + Vector3.new(0, 2, 0)) * CFrame.Angles(math.rad(angle), 0, 0)
                align.Position = root.Position + Vector3.new(2, 0, 0)
            end)

            task.wait()
        end

        -- Limpeza
        if align then align:Destroy() end
        
        pcall(function()
            hum:SetStateEnabled(Enum.HumanoidStateType.Seated, true)
            hum.PlatformStand = false
        end)
        
        cam.CameraSubject = hum

        for _, p in pairs(char:GetDescendants()) do
            if p:IsA("BasePart") then
                p.Velocity = Vector3.zero
                p.RotVelocity = Vector3.zero
            end
        end

        task.wait(0.1)
        
        if success then
            root.CFrame = CFrame.new(sitPos)
            task.wait(0.5)
        end

        task.wait(0.3)

        local tool = char:FindFirstChild("Couch")
        if tool then 
            tool.Parent = LocalPlayer.Backpack 
        end

        task.wait(0.01)
        
        pcall(function()
            ReplicatedStorage.RE:FindFirstChild("1Too1l"):InvokeServer("PickingTools", "Couch")
        end)
        task.wait(0.2)
        
        if not success then
            root.CFrame = CFrame.new(originalPos)
        end
        
        OrionLib:MakeNotification({
            Name = success and "Sucesso!" or "Falha",
            Content = success and "Player morto com sucesso!" or "Não foi possível matar o player",
            Image = "rbxassetid://4483345998",
            Time = 3
        })
    end)
end

-- Função para obter lista de jogadores
local function getPlayerList()
    local players = Players:GetPlayers()
    local playerNames = {}
    for _, player in ipairs(players) do
        if player ~= LocalPlayer then
            table.insert(playerNames, player.Name)
        end
    end
    return playerNames
end

