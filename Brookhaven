local antiSitToggle = false
local antiSitConnections = {}

TrollGroup:AddToggle("AntiSit", {
    Text = "Anti Sit",
    Default = false,
    Callback = function(Value)
        antiSitToggle = Value
        if antiSitToggle then
            local function preventSitting(humanoid)
                if humanoid then
                    humanoid:SetStateEnabled(Enum.HumanoidStateType.Seated, false)
                    local con = humanoid.StateChanged:Connect(function(_, newState)
                        if newState == Enum.HumanoidStateType.Seated then
                            humanoid:ChangeState(Enum.HumanoidStateType.GettingUp)
                        end
                    end)
                    table.insert(antiSitConnections, con)
                end
            end

            local function monitorCharacter()
                local con = LocalPlayer.CharacterAdded:Connect(function(character)
                    local humanoid = character:WaitForChild("Humanoid")
                    preventSitting(humanoid)
                end)
                table.insert(antiSitConnections, con)
                if LocalPlayer.Character then
                    preventSitting(LocalPlayer.Character:FindFirstChildOfClass("Humanoid"))
                end
            end

            monitorCharacter()
            local hb = RunService.Heartbeat:Connect(function()
                local humanoid = LocalPlayer.Character and LocalPlayer.Character:FindFirstChildOfClass("Humanoid")
                if humanoid then
                    humanoid:SetStateEnabled(Enum.HumanoidStateType.Seated, false)
                end
            end)
            table.insert(antiSitConnections, hb)
        else
            for _, con in ipairs(antiSitConnections) do
                con:Disconnect()
            end
            antiSitConnections = {}
            local humanoid = LocalPlayer.Character and LocalPlayer.Character:FindFirstChildOfClass("Humanoid")
            if humanoid then
                humanoid:SetStateEnabled(Enum.HumanoidStateType.Seated, true)
            end
        end
    end,
})

