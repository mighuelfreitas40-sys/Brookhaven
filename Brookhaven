        drone.Transparency = 1
        drone.CanCollide = true
        drone.Position = rootPart.Position
        drone.Parent = workspace
        drone.Friction = 0
        invisData.drone = drone

        cam.CameraSubject = drone

        rootPart.CFrame = CFrame.new(-84, 500, 96)
        task.wait(0.2)
        rootPart.Anchored = true

        local querPular = false
        local jumpCon = UserInputService.JumpRequest:Connect(function()
            local ray = Ray.new(drone.Position, Vector3.new(0, -3.5, 0))
            local hit = workspace:FindPartOnRay(ray, drone)
            if hit then querPular = true end
        end)

        local rsCon = RunService.RenderStepped:Connect(function(dt)
            local moveDir = humanoid.MoveDirection
            if moveDir.Magnitude > 0 then
                drone.Position = drone.Position + (moveDir * 50 * dt)
            end
            if querPular then
                drone.Velocity = Vector3.new(drone.Velocity.X, 50, drone.Velocity.Z)
                querPular = false
            end
            drone.RotVelocity = Vector3.new(0, 0, 0)
        end)

        invisData.connection = {jumpCon, rsCon}

        notify("Invisibilidade", "Ativada! Use WASD para mover, Espaco para pular")
    end,
})

