TrollTab:AddButton({
    Name = "Ativar Invisibilidade (Drone)",
    Callback = function()
        local Players = game:GetService("Players")
        local RunService = game:GetService("RunService")
        local UserInputService = game:GetService("UserInputService")
        local player = Players.LocalPlayer
        local character = player.Character or player.CharacterAdded:Wait()
        local rootPart = character:WaitForChild("HumanoidRootPart")
        local humanoid = character:WaitForChild("Humanoid")
        local camera = workspace.CurrentCamera

        -- 1. CONFIGURAÇÕES
        local ALTURA_ESCONDIDA = 500 
        local VELOCIDADE = 50
        local FORCA_PULO = 50
        local posicaoOriginal = rootPart.Position

        -- 2. CRIAR O "DRONE" INVISÍVEL
        local drone = Instance.new("Part")
        drone.Name = "DroneInvisivel"
        drone.Shape = Enum.PartType.Ball
        drone.Size = Vector3.new(3, 3, 3)
        drone.Transparency = 1 
        drone.CanCollide = true 
        drone.Position = posicaoOriginal
        drone.Parent = workspace
        drone.Friction = 0

        -- Prende a câmera
        camera.CameraSubject = drone

        -- 3. ESCONDER O CORPO REAL
        rootPart.CFrame = CFrame.new(-84, ALTURA_ESCONDIDA, 96)
        task.wait(0.2)
        rootPart.Anchored = true 

        -- 4. SISTEMA DE MOVIMENTO E PULO
        local function getMoveDirection()
            return humanoid.MoveDirection
        end

        local querPular = false
        UserInputService.JumpRequest:Connect(function()
            local ray = Ray.new(drone.Position, Vector3.new(0, -3.5, 0))
            local hit = workspace:FindPartOnRay(ray, drone)
            
            if hit then
                querPular = true
            end
        end)

        RunService.RenderStepped:Connect(function(dt)
            local moveDir = getMoveDirection()
            
            if moveDir.Magnitude > 0 then
                drone.Position = drone.Position + (moveDir * VELOCIDADE * dt)
            end
            
            if querPular then
                drone.Velocity = Vector3.new(drone.Velocity.X, FORCA_PULO, drone.Velocity.Z)
                querPular = false
            end
            
            drone.RotVelocity = Vector3.new(0,0,0)
        end)

        OrionLib:MakeNotification({
            Name = "Invisibilidade",
            Content = "Ativada! Use WASD para mover, Espaço para pular",
            Image = "rbxassetid://4483345998",
            Time = 3
        })
    end
})

