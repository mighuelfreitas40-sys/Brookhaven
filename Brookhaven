        end
        
        -- Salvar posição original
        originalPos = rootPart.CFrame
        
        -- Procurar por assento no carro
        local seat = nil
        local function findSeat(model)
            for _, child in ipairs(model:GetDescendants()) do
                if child:IsA("VehicleSeat") then
                    return child
                end
            end
            return nil
        end
        
        seat = findSeat(car)
        
        if seat then
            -- Tentar sentar no assento
            rootPart.CFrame = seat.CFrame * CFrame.new(0, 2, 0)
            task.wait(0.3)
            
            -- Forçar sentar se necessário
            if not humanoid.Sit then
                humanoid.Sit = true
            end
            
            OrionLib:MakeNotification({
                Name = "Sucesso",
                Content = "Você está dentro do carro!",
                Image = "rbxassetid://4483345998",
                Time = 2
            })
            
            -- Aguardar 2 segundos
            task.wait(2)
            
            -- Voltar para posição original (MODIFICADO)
            -- Verifica se é local apertado (baseado na posição Y)
            local isTightSpace = originalPos.Y < 10 or originalPos.Y > 100 -- Exemplo: locais muito baixos ou altos podem ser apertados
            
            if isTightSpace then
                -- Teleporta apenas 3 studs para cima
                rootPart.CFrame = originalPos * CFrame.new(0, 3, 0)
            else
                -- Teleporta 8 studs para cima
                rootPart.CFrame = originalPos * CFrame.new(0, 8, 0)
            end
            
            task.wait(0.1)
            humanoid.Sit = false
            
            OrionLib:MakeNotification({
                Name = "Voltou",
                Content = isTightSpace and "Voltou 3 studs acima" or "Voltou 8 studs acima",
                Image = "rbxassetid://4483345998",
                Time = 2
            })
        else
            -- Se não achar assento, apenas teleportar para o centro do carro
            local primaryPart = car.PrimaryPart or car:FindFirstChildWhichIsA("BasePart")
            if primaryPart then
                rootPart.CFrame = primaryPart.CFrame * CFrame.new(0, 3, 0)
                OrionLib:MakeNotification({
                    Name = "Aviso",
                    Content = "Assento não encontrado, teleportado para o carro",
                    Image = "rbxassetid://4483345998",
                    Time = 3
                })
                task.wait(2)
                
                -- Mesma lógica de volta
                local isTightSpace = originalPos.Y < 10 or originalPos.Y > 100
                if isTightSpace then
                    rootPart.CFrame = originalPos * CFrame.new(0, 3, 0)
                else
                    rootPart.CFrame = originalPos * CFrame.new(0, 8, 0)
                end
            end
        end
    end
})

