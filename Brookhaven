local flyCarActive = false

CarGroup:AddButton({
    Text = "Fly Car",
    Func = function()
        flyCarActive = not flyCarActive

        if flyCarActive then
            local player = Players.LocalPlayer
            local camera = workspace.CurrentCamera
            local speed = 100
            local stabilityPower = 1e6

            local bv = Instance.new("BodyVelocity")
            local bg = Instance.new("BodyGyro")

            bv.MaxForce = Vector3.new(math.huge, math.huge, math.huge)
            bg.MaxTorque = Vector3.new(math.huge, math.huge, math.huge)
            bg.P = stabilityPower
            bg.D = 1000

            local flyConnection = RunService.RenderStepped:Connect(function()
                local char = player.Character
                local humanoid = char and char:FindFirstChild("Humanoid")
                local seat = humanoid and humanoid.SeatPart

                if seat and seat:IsA("VehicleSeat") then
                    local carRoot = seat.Parent.PrimaryPart or seat
                    bv.Parent = carRoot
                    bg.Parent = carRoot
                    local moveDir = humanoid.MoveDirection
                    if moveDir.Magnitude > 0 then
                        local isGoingForward = seat.CFrame.LookVector:Dot(moveDir) > 0.5
                        if isGoingForward then
                            bv.Velocity = camera.CFrame.LookVector * speed
                        else
                            bv.Velocity = moveDir * speed
                        end
                    else
                        bv.Velocity = Vector3.new(0, 0, 0)
                    end

                    local camLook = camera.CFrame.LookVector
                    local flatLook = Vector3.new(camLook.X, 0, camLook.Z).Unit
                    if flatLook.Magnitude > 0.1 then
                        bg.CFrame = CFrame.new(carRoot.Position, carRoot.Position + flatLook)
                    end
                else
                    bv.Parent = nil
                    bg.Parent = nil
                end
            end)

            getgenv().FlyCarConnection = flyConnection
            getgenv().FlyCarBodyVelocity = bv
            getgenv().FlyCarBodyGyro = bg
            notify("Fly Car", "Ativado! Entre em um carro e use WASD para voar")
        else
            if getgenv().FlyCarConnection then
                getgenv().FlyCarConnection:Disconnect()
                getgenv().FlyCarConnection = nil
            end
            if getgenv().FlyCarBodyVelocity then
                getgenv().FlyCarBodyVelocity:Destroy()
                getgenv().FlyCarBodyVelocity = nil
            end
            if getgenv().FlyCarBodyGyro then
                getgenv().FlyCarBodyGyro:Destroy()
                getgenv().FlyCarBodyGyro = nil
            end

            workspace.CurrentCamera.CameraType = Enum.CameraType.Custom

            local vehicles = workspace:FindFirstChild("Vehicles")
            if vehicles then
                for _, car in ipairs(vehicles:GetChildren()) do
                    if car:IsA("Model") then
                        for _, child in ipairs(car:GetDescendants()) do
                            if child:IsA("BodyVelocity") or child:IsA("BodyGyro") then
                                child:Destroy()
                            end
                        end
                    end
                end
            end
            notify("Fly Car", "Desativado")
        end
    end,
})
