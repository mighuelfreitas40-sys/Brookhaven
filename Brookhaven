                local carRoot = seat.Parent.PrimaryPart or seat
                
                bv.Parent = carRoot
                bg.Parent = carRoot
                
                local moveDir = humanoid.MoveDirection
                
                if moveDir.Magnitude > 0 then
                    local isGoingForward = seat.CFrame.LookVector:Dot(moveDir) > 0.5
                    
                    if isGoingForward then
                        bv.Velocity = camera.CFrame.LookVector * speed
                    else
                        bv.Velocity = moveDir * speed
                    end
                else
                    bv.Velocity = Vector3.new(0, 0, 0)
                end
                
                bg.CFrame = camera.CFrame
            else
                bv.Parent = nil
                bg.Parent = nil
            end
        end)
        
        getgenv().FlyCarConnection = flyConnection
        
        OrionLib:MakeNotification({
            Name = "Fly Car",
            Content = "Ativado! Entre em um carro e use WASD para voar",
